{
  "$schema": "https://vercel.com/schemas/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private, must-revalidate"
        }
      ]
    }
  ],
  
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://krumm-backend.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  
  "redirects": [
    {
      "source": "/pitch",
      "destination": "/",
      "permanent": false
    }
  ],
  
  "functions": {
    "server/**/*.js": {
      "runtime": "nodejs20.x"
    }
  }
}
