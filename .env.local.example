# ============================================================================
# Local Development Environment (.env.local)
# ============================================================================
# Copy to .env.local and customize for your local machine
# Uses SQLite (auto-created at data/krumm.db) and in-memory rate limiting
# ============================================================================

# APPLICATION CORE
NODE_ENV=development

# BACKEND SERVER
PORT=4000
JWT_SECRET_KEY=dev-jwt-secret-key-only-for-testing
RECRUITER_EMAIL=recruiter@test.local
RECRUITER_PASSWORD=recruiter-test-password
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# DATABASE (SQLite for development)
DB_CLIENT=sqlite
# DATABASE_URL left empty = uses SQLite at data/krumm.db

# AI & GEMINI
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# LOGGING
LOG_LEVEL=debug

# RATE LIMITING (in-memory for development)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX_REQUESTS=1000
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX_REQUESTS=50

# REDIS (leave empty for in-memory rate limiting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# AI CIRCUIT BREAKER
AI_CIRCUIT_WINDOW_MS=60000
AI_CIRCUIT_THRESHOLD=5
AI_CIRCUIT_OPEN_MS=300000

# FEATURE FLAGS
ENABLE_HERO_DEMO=true
HERO_DEMO_PERCENTAGE=100

# FRONTEND
VITE_API_BASE_URL=http://localhost:4000
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_USE_BACKEND_GEMINI_PROXY=true
VITE_ALLOW_BROWSER_GEMINI_FALLBACK=false
VITE_BASE_PATH=/
