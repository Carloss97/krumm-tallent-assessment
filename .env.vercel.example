# ============================================================================
# Vercel Frontend Environment (.env.vercel)
# ============================================================================
# Environment variables for React frontend deployed on Vercel
# Add these to Vercel's "Settings > Environment Variables" dashboard
# ============================================================================

# API ENDPOINT (point to your Render backend)
# Example: https://krumm-backend.onrender.com
VITE_API_BASE_URL=https://your-render-backend-url.onrender.com

# GEMINI CONFIGURATION (frontend should use backend proxy)
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_USE_BACKEND_GEMINI_PROXY=true

# Frontend SHOULD NOT have API key for security (use backend proxy instead)
# VITE_GEMINI_API_KEY is intentionally NOT included here

# Fallback disabled in production (backend proxy is primary)
VITE_ALLOW_BROWSER_GEMINI_FALLBACK=false

# BASE PATH (if deployed to subdirectory; usually / for root)
VITE_BASE_PATH=/

# ============================================================================
# HOW TO DEPLOY ON VERCEL:
# ============================================================================
# 1. Connect GitHub repo to Vercel
# 2. Go to Settings > Environment Variables
# 3. Add each VITE_* variable above
# 4. Deploy: git push origin main (auto-triggers Vercel build)
# 5. Vercel will run: npm install && npm run build
# 6. Output: dist/ folder deployed to CDN
#
# Vercel automatically supports:
# - Environment variables prefixed with VITE_ (exposed to browser)
# - Build command configuration in vercel.json
# - API rewrites for backend proxying
# ============================================================================
