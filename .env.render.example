# ============================================================================
# Render Backend Environment (.env.render)
# ============================================================================
# Environment variables for Express backend deployed on Render
# Use these settings in Render's "Environment" dashboard
# ============================================================================

# APPLICATION CORE
NODE_ENV=production

# BACKEND SERVER (Render auto-assigns PORT)
PORT=4000
JWT_SECRET_KEY=your-production-jwt-secret-key-32-chars-minimum
RECRUITER_EMAIL=your-recruiter-email@example.com
RECRUITER_PASSWORD=your-recruiter-password-secure
ALLOWED_ORIGINS=https://app.example.com,https://www.example.com,https://yourdomain.vercel.app

# DATABASE (Neon PostgreSQL)
DB_CLIENT=pg
DATABASE_URL=postgresql://user:password@your-neon-hostname.neon.tech/dbname?sslmode=require

# AI & GEMINI (backend only)
GEMINI_API_KEY=your-production-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# LOGGING
LOG_LEVEL=info
LOG_COLLECTOR_URL=https://your-log-collector.example.com/logs
LOG_COLLECTOR_API_KEY=your-log-collector-api-key

# RATE LIMITING (with Redis)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX_REQUESTS=180
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX_REQUESTS=20

# REDIS (Upstash)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# AI CIRCUIT BREAKER
AI_CIRCUIT_WINDOW_MS=60000
AI_CIRCUIT_THRESHOLD=5
AI_CIRCUIT_OPEN_MS=300000

# FEATURE FLAGS (conservative defaults for production)
ENABLE_HERO_DEMO=false
HERO_DEMO_PERCENTAGE=0

# Note: Frontend env vars (VITE_*) are NOT set here; they go in Vercel
