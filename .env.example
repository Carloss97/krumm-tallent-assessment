# KRUMM local environment template — no secrets committed.
# Copy to .env.local for Vite or .env for the Express server and fill only what you need.

# Frontend
VITE_API_BASE_URL=http://localhost:4000
VITE_BASE_PATH=/
VITE_ALLOWED_DEV_HOSTS=localhost,127.0.0.1
VITE_USE_EDGE_LOCAL_INFERENCE=true
VITE_ENABLE_GEMINI_FALLBACK=false
VITE_USE_BACKEND_GEMINI_PROXY=true
# VITE_GOOGLE_API_KEY=[REDACTED]

# Backend
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
DB_CLIENT=sqlite
# DATABASE_URL=[REDACTED]
# JWT_SECRET_KEY=[REDACTED]
# GEMINI_API_KEY=[REDACTED]
GEMINI_MODEL=gemini-1.5-flash
ENABLE_HERO_DEMO=true
HERO_DEMO_PERCENTAGE=100
# PARTICIPANT_ACCESS_CODE=[REDACTED]
# RECRUITER_EMAIL=[REDACTED]
# RECRUITER_PASSWORD=[REDACTED]
# UPSTASH_REDIS_REST_URL=[REDACTED]
# UPSTASH_REDIS_REST_TOKEN=[REDACTED]
