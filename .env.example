# Google Gemini API Configuration
# Server-side key only. Do not expose real Gemini keys through VITE_* variables in production.
GOOGLE_API_KEY=YOUR_SERVER_SIDE_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash-latest
VITE_GEMINI_MODEL=gemini-1.5-flash
VITE_USE_BACKEND_GEMINI_PROXY=true
VITE_ALLOW_BROWSER_GEMINI_FALLBACK=false

# API Backend Configuration
VITE_API_BASE_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET_KEY=change-me-to-a-random-32-plus-character-secret
JWT_PARTICIPANT_EXPIRES_IN=15m
JWT_RECRUITER_EXPIRES_IN=8h
PARTICIPANT_ACCESS_CODE=change-me
RECRUITER_EMAIL=recruiter@example.com
RECRUITER_PASSWORD=change-me

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX_REQUESTS=180
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=8

# Database Configuration
# Use pg in deployed environments and sqlite only for local development.
DB_CLIENT=sqlite
DATABASE_URL=
DB_PATH=./assessments.db

# Optional logging collector
LOG_COLLECTOR_URL=
LOG_COLLECTOR_API_KEY=
